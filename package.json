    "format": "prettier --write ."
  },
  "dependencies": {
    "ink": "^7.0.0",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.0.0",
    "ink-testing-library": "^3.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
